DATABASE_URL="postgresql://postgres@localhost:5432/nest_clean_architecture"
# Comma-separated read replicas. Leave empty to route every read to the primary.
DATABASE_REPLICA_URLS="postgresql://postgres@localhost:5433/nest_clean_architecture"
DB_POOL_MAX=10
DB_REPLICA_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=10000
HOST_NAME=localhost
GATEWAY_PORT=3000
USER_SERVICE_PORT=3001
LOCATION_SERVICE_PORT=3002
PAYMENT_SERVICE_PORT=3003
CHATBOT_SERVICE_PORT=3004
NOTIFICATION_SERVICE_PORT=3005
BOOKING_SERVICE_PORT=3006
BOOKING_SERVICE_HOST=localhost
EMAIL_FROM=no-reply@example.com
RABBITMQ_URL=amqp://guest:guest@localhost:5672
NOTIFICATION_QUEUE=notifications_queue

# --- Booking service ---
# Recipient of the "new confirmed booking" email.
HOMESTAY_OWNER_EMAIL=hanvietha141+owner@gmail.com
# Origin the emailed cancel link points at. This must be the FRONTEND origin,
# not the gateway: the service appends the literal "/bookings/cancel/<token>",
# and that path is a frontend page which fetches GET /api/bookings/cancel/<token>
# and POSTs only when the customer presses the button. Pointing this at the
# gateway (http://localhost:3000) mails out a raw JSON URL instead.
PUBLIC_BASE_URL=http://localhost:4000
# Publishing to RabbitMQ must never outlive an RPC handler.
EMAIL_EMIT_TIMEOUT_MS=2000
# Which mailer gets the booking emails: `ses` (api-email) or `gmail` (api-gmail).
# It only picks the routing key, so the matching service has to be running -
# otherwise the messages queue up unconsumed and no mail goes out.
EMAIL_PROVIDER=ses
# How long a PENDING booking holds its slot before the sweep expires it.
BOOKING_HOLD_TTL_MINUTES=1
DAILY_MAINTENANCE_CRON=5 0 * * *
