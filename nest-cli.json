{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "monorepo": true,
  "root": "apps/api-gateway",
  "sourceRoot": "apps/api-gateway/src",
  "compilerOptions": {
    "deleteOutDir": true
  },
  "projects": {
    "api-gateway": {
      "type": "application",
      "root": "apps/api-gateway",
      "entryFile": "main",
      "sourceRoot": "apps/api-gateway/src",
      "compilerOptions": {
        "tsConfigPath": "apps/api-gateway/tsconfig.app.json"
      }
    },
    "api-location": {
      "type": "application",
      "root": "apps/api-location",
      "entryFile": "main",
      "sourceRoot": "apps/api-location/src",
      "compilerOptions": {
        "tsConfigPath": "apps/api-location/tsconfig.app.json"
      }
    },
    "api-payment": {
      "type": "application",
      "root": "apps/api-payment",
      "entryFile": "main",
      "sourceRoot": "apps/api-payment/src",
      "compilerOptions": {
        "tsConfigPath": "apps/api-payment/tsconfig.app.json"
      }
    },
    "api-user": {
      "type": "application",
      "root": "apps/api-user",
      "entryFile": "main",
      "sourceRoot": "apps/api-user/src",
      "compilerOptions": {
        "tsConfigPath": "apps/api-user/tsconfig.app.json"
      }
    },
    "api-chatbot": {
      "type": "application",
      "root": "apps/api-chatbot",
      "entryFile": "main",
      "sourceRoot": "apps/api-chatbot/src",
      "compilerOptions": {
        "tsConfigPath": "apps/api-chatbot/tsconfig.app.json"
      }
    },
    "api-notification": {
      "type": "application",
      "root": "apps/api-notification",
      "entryFile": "main",
      "sourceRoot": "apps/api-notification/src",
      "compilerOptions": {
        "tsConfigPath": "apps/api-notification/tsconfig.app.json"
      }
    },
    "api-email": {
      "type": "application",
      "root": "apps/api-email",
      "entryFile": "main",
      "sourceRoot": "apps/api-email/src",
      "compilerOptions": {
        "tsConfigPath": "apps/api-email/tsconfig.app.json"
      }
    },
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common/tsconfig.lib.json"
      }
    },
    "database": {
      "type": "library",
      "root": "libs/database",
      "entryFile": "index",
      "sourceRoot": "libs/database/src",
      "compilerOptions": {
        "tsConfigPath": "libs/database/tsconfig.lib.json"
      }
    }
  }
}
