RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Own queue on the shared emails.topic exchange, bound to `email.send.gmail`.
# api-email keeps consuming `email.send`, so SES delivery is unaffected.
GMAIL_QUEUE=gmail_emails_queue

# Sender identity applied when a caller omits `from`. Gmail only accepts the
# authenticated mailbox or one of its verified "send as" aliases.
GMAIL_SENDER=no-reply@example.com

# OAuth2 client from Google Cloud Console (APIs & Services > Credentials), type
# "Desktop app", with the Gmail API enabled and the
# https://www.googleapis.com/auth/gmail.send scope on the consent screen.
#
# GMAIL_REFRESH_TOKEN comes from a one-time consent flow. Run it once per mailbox:
#   GMAIL_CLIENT_ID=... GMAIL_CLIENT_SECRET=... \
#     node apps/api-gmail/scripts/get-refresh-token.js
#
# On WSL2 the browser runs on Windows and may not reach the callback inside the VM.
# The script also accepts the redirect URL pasted straight into its terminal.
#
# Keep the consent screen in "Production", not "Testing": tokens issued while an
# app is in Testing expire after 7 days and the service starts failing silently.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Optional overrides, mainly for tests or a proxy.
# GMAIL_TOKEN_ENDPOINT=https://oauth2.googleapis.com/token
# GMAIL_SEND_ENDPOINT=https://gmail.googleapis.com/gmail/v1/users/me/messages/send
