RABBITMQ_URL=amqp://guest:guest@localhost:5672
EMAIL_QUEUE=emails_queue

# Sender identity applied when a caller omits `from`. Must be a verified SES
# identity. api-booking deliberately leaves `from` unset so the address lives
# in exactly one place.
EMAIL_FROM=no-reply@example.com

AWS_SES_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional SES configuration set for event publishing.
AWS_SES_CONFIGURATION_SET=
